# Large input and intermediate data (downloaded or regenerated by the scripts)
*.fasta
*.fasta.*
*.fa
*.fna
*.gz
*.bam
*.bai
*.tbi
*.csi
*.bed
input/
benchmark/
calls/
# hap.py writes many files; only the summary CSVs are kept
results/*
!results/*.summary.csv
# Logs and system files
*.log
*.o[0-9]*
*.e[0-9]*
__pycache__/
.DS_Store
